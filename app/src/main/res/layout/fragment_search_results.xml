<?xml version="1.0" encoding="utf-8"?>
<!--
    Uses the same @color tokens as the other screens (brand_blue, screen_bg,
    card_bg, card_stroke, text_primary, text_secondary) so it follows the
    app-wide theme and switches automatically in dark mode via
    res/values-night/colors.xml. No new resources needed beyond what you
    already added for the search and PDF-viewer screens.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/screen_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_toolbar_gradient"
        android:elevation="4dp"
        app:title="Question Papers"
        app:titleTextColor="@android:color/white"
        app:titleTextAppearance="@style/ToolbarTitleAppearance"
        app:navigationIcon="@drawable/baseline_arrow_back"
        app:navigationIconTint="@android:color/white"/>

    <!-- Header Card -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/card_stroke"
        app:cardBackgroundColor="@color/card_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚 Question Papers"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/brand_blue"/>

            <TextView
                android:id="@+id/txtResultCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Found 0 papers"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearchAgain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Search Again"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/brand_blue"
                app:rippleColor="@color/brand_blue_dark"
                app:icon="@android:drawable/ic_menu_search"
                app:iconTint="@android:color/white"
                app:cornerRadius="50dp"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Progress -->

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/brand_blue"
        android:visibility="gone"/>

    <!-- Papers -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewPapers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="20dp"
        android:layoutAnimation="@anim/layout_animation_fall_down"/>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F4F7FC">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Question Papers"
        app:navigationIcon="@drawable/baseline_arrow_back"/>
    <!-- Header Card -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚 Question Papers"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1565C0"/>

            <TextView
                android:id="@+id/txtResultCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Found 0 papers"
                android:textSize="16sp"
                android:textColor="#666666"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearchAgain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Search Again"
                android:textAllCaps="false"
                android:backgroundTint="#1565C0"
                android:icon="@android:drawable/ic_menu_search"
                app:cornerRadius="50dp"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Progress -->

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <!-- Papers -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewPapers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        android:layoutAnimation="@anim/layout_animation_fall_down"/>

</LinearLayout>